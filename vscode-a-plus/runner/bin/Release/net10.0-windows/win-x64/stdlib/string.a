export func split(s, sep) {
    let r = []
    let start = 0
    let i = 0
    while (i < s.len) {
        if (s.sub(i, 1) == sep) {
            r.add(s.sub(start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    r.add(s.sub(start, i - start))
    return r
}
export func join(list, sep) {
    let r = ""
    let i = 0
    for (item in list) {
        if (i > 0) { r = r + sep }
        r = r + item
        i = i + 1
    }
    return r
}
export func reverse(s) {
    let r = ""
    let i = s.len - 1
    while (i >= 0) { r = r + s.sub(i, 1); i = i - 1 }
    return r
}
export func trim(s) {
    let start = 0
    let end = s.len - 1
    while (start <= end and (s.sub(start, 1) == " " or s.sub(start, 1) == "\t" or s.sub(start, 1) == "\n")) { start = start + 1 }
    while (end >= start and (s.sub(end, 1) == " " or s.sub(end, 1) == "\t" or s.sub(end, 1) == "\n")) { end = end - 1 }
    return s.sub(start, end - start + 1)
}
export func startsWith(s, prefix) {
    if (prefix.len > s.len) { return false }
    return s.sub(0, prefix.len) == prefix
}
export func endsWith(s, suffix) {
    if (suffix.len > s.len) { return false }
    return s.sub(s.len - suffix.len, suffix.len) == suffix
}
export func count(s, sub) {
    let c = 0
    let i = 0
    while (true) {
        let foundAt = s.indexOf(sub)
        if (foundAt < 0) { return c }
        c = c + 1
        s = s.sub(foundAt + sub.len)
    }
    return c
}
export func repeat(s, n) {
    let r = ""
    let i = 0
    while (i < n) { r = r + s; i = i + 1 }
    return r
}
export func padLeft(s, len, ch) {
    if (s.len >= len) { return s }
    return repeat(ch, len - s.len) + s
}
export func padRight(s, len, ch) {
    if (s.len >= len) { return s }
    return s + repeat(ch, len - s.len)
}
