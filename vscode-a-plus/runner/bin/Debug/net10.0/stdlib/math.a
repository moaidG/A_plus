export func abs(x) { if (x < 0) { return -x } return x }
export func sqrt(x) { return dotnet("System.Math", "Sqrt", x) }
export func sin(x) { return dotnet("System.Math", "Sin", x) }
export func cos(x) { return dotnet("System.Math", "Cos", x) }
export func tan(x) { return dotnet("System.Math", "Tan", x) }
export func floor(x) { return dotnet("System.Math", "Floor", x) }
export func ceil(x) { return dotnet("System.Math", "Ceiling", x) }
export func round(x) { return dotnet("System.Math", "Round", x) }
export func max(a, b) { if (a > b) { return a } return b }
export func min(a, b) { if (a < b) { return a } return b }
export func clamp(x, lo, hi) { if (x < lo) { return lo } if (x > hi) { return hi } return x }
export func lerp(a, b, t) { return a + (b - a) * t }
export func sign(x) { if (x > 0) { return 1 } if (x < 0) { return -1 } return 0 }
export func pi() { return 3.141592653589793 }
