{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "wordPattern": "(-?\\d*\\.\\d+\\w*)|([^\\s\\[\\]{}()\"'`,;:<>./?#@!|&*+\\-=^~\\\\]+)",
  "indentationRules": {
    "increaseIndentPattern": "(?:\\{[^}\"']*|\\([^)\"']*|\\[[^\\]\"']*|\\b(?:if|else|while|for|func|function|دالة|class|صنف|try|catch|finally|حاول|التقط|أخيراً|switch|اختيار)\\b[^{]*)$",
    "decreaseIndentPattern": "^\\s*[}\\]\\)]|^\\s*\\b(?:else|وإلا|catch|التقط|finally|أخيراً)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*\\/\\/\\/\\s*$",
      "action": { "indent": "none", "appendText": "/// " }
    },
    {
      "beforeText": "\\{$",
      "afterText": "^\\s*\\}$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "\\{$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "\\[\\s*\\]$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "\\(\\s*\\)$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "\\b(else|وإلا|catch|التقط|finally|أخيراً)\\s*\\{$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "\\b(case|حالة|default|افتراضي)\\s*:",
      "afterText": "^\\s*(case|حالة|default|افتراضي)\\b",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "\\b(case|حالة|default|افتراضي)\\s*:",
      "action": { "indent": "indent" }
    }
  ],
  "__electricCharacterSupport": {
    "docComment": {
      "scope": "comment.block.documentation",
      "lineStart": "^\\s*",
      "open": "/**",
      "close": " */",
      "notIn": ["string", "comment"]
    }
  }
}
