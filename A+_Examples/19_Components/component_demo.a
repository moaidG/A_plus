// A+ Component System Demo
// Demonstrates: component functions, a+ xml, anonymous event handlers, img/src/onclick aliases
//donot work the web
// 1. Component function that returns an image with text overlay
func createCard(title, imgUrl) {
    <img src=imgUrl Width="300" Height="200">
        <TextBlock Text=title FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
    </img>
}

// 2. Component function with button and event handler
func createButton(label) {
    <Button Content=label Width="150" Height="40"
            onclick=()=>{print("Button '" + label + "' clicked!")}/>
}

// 3. Use a+ xml to call component functions
a+ xml card1 = <createCard title="A+ Language" imgUrl="icons.png"/>

a+ xml card2 = <createCard title="Component System" imgUrl="loge_m_ait.png"/>

// 4. Use a+ xml with inline XML and anonymous event handler
a+ new dev myBtn = {
    <Button Content="Click Me!" Width="200" Height="50" FontSize="16"
            onclick=()=>{print("Button clicked 1!")} Name="B"/>
}
B.Click=()=>{print("Button clicked 2!")}
// 5. Traditional approach still works
a+ new StackPanel Panel
Panel.width = 900
Panel.Height=700
Panel.add(card1)
Panel.add(card2)
Panel.add(myBtn)
show()
