// مثال البرمجة غير المتزامنة بالعربية

غيرمتزامن دالة احصلبيانات() {
    رجع 42
}

غيرمتزامن دالة الرئيسية() {
    اطبع("جارٍ جلب البيانات...")
    متغير نتيجة = انتظر احصلبيانات()
    اطبع("النتيجة: " + نتيجة)
}

الرئيسية()

// انطلق — إطلاق بدون انتظار
انطلق احصلبيانات()
اطبع("هذا يطبع فوراً")

// إنشاء مهمة
أنشئ عامل(ن) {
    اطبع("بدأت المهمة: " + ن)
    رجع ن * 2
}

متغير ص = انتظر عامل(10)
اطبع("ناتج العامل: " + ص)
