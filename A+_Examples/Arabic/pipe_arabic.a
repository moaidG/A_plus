// مثال عامل الأنبوب بالعربية

دالة ضعف(س) { رجع س * 2 }
دالة اجمع(أ, ب) { رجع أ + ب }
دالة اضرب(أ, ب) { رجع أ * ب }

// أنبوب بسيط
متغير ن1 = 5 | ضعف
اطبع("5 | ضعف = " + ن1)

// أنبوب مع استدعاء دالة
متغير ن2 = 5 | اجمع(3)
اطبع("5 | اجمع(3) = " + ن2)

// أنبوب متسلسل
متغير ن3 = 5 | ضعف | اجمع(3)
اطبع("5 | ضعف | اجمع(3) = " + ن3)

// أنبوب مع وسائط متعددة
متغير ن4 = 10 | اضرب(2) | اجمع(5)
اطبع("10 | اضرب(2) | اجمع(5) = " + ن4)
