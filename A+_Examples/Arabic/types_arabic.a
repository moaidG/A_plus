// مثال الأنواع والمولدات بالعربية

// تعليقات الأنواع
متغير اسم: string = "أ+"
متغير عدد: number = 100
متغير علم: bool = صحيح

اطبع("الاسم: " + اسم)
اطبع("العدد: " + عدد)
اطبع("العلم: " + علم)

// دالة مع أنواع
دالة اجمع(أ: number, ب: number): number {
    رجع أ + ب
}

اطبع("اجمع(3, 4) = " + اجمع(3, 4))
