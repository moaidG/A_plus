// مثال التعبيرات المنتظمة بالعربية

// .test() — اختبار التطابق
متغير نمط = /مرحبا/
اطبع("اختبار1: " + نمط.test("مرحبا بالعالم"))  // 1 (true)
اطبع("اختبار2: " + نمط.test("وداعاً"))         // 0 (false)

// .match() — إيجاد التطابقات
متغير ارقام = /\d+/
متغير تطابقات = ارقام.match("abc123def456")
لكل (عنصر in تطابقات) {
    اطبع("تطابق: " + عنصر)  // 123, 456
}

// .replace() — استبدال
متغير استبدال = /عالم/
متغير مستبدل = استبدال.replace("مرحبا بالعالم", "أ+")
اطبع("مستبدل: " + مستبدل)  // مرحبا بأ+
