# الكلاسات في A+ بالعربية
صنف حيوان {
    متغير اسم
    متغير عمر

    دالة تكلم() {
        اطبع(اسم + " يصدر صوتا")
    }

    دالة معلومات() {
        اطبع("الاسم: " + اسم + "، العمر: " + عمر)
    }
}

# الوراثة
صنف كلب / حيوان {
    دالة تكلم() {
        اطبع(اسم + " ينبح")
    }
}

# الاستخدام
متغير حيوان1 = جديد حيوان()
حيوان1.اسم = "قط"
حيوان1.عمر = 3
حيوان1.تكلم()
حيوان1.معلومات()

متغير كلب1 = جديد كلب()
كلب1.اسم = "ركس"
كلب1.عمر = 2
كلب1.تكلم()

# تجربة الخطأ
محاولة {
    اطبع("تجربة...")
} القط (خطأ) {
    اطبع("حدث خطأ: " + خطأ)
}
