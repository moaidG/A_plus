# أمثلة عربية - A+
اطبع("مرحبا بك في لغة A+!")
اطبع("هذه لغة برمجة تدعم العربية والإنجليزية")

# المتغيرات
متغير اسم = "أحمد"
متغير عمر = 25
اطبع("الاسم: " + اسم + "، العمر: " + عمر)
# الشروط
إذا (عمر >= 18) {
    اطبع("أنت بالغ")
} وإلا {
    اطبع("أنت قاصر")
}

# الحلقات
متغير ع = 0
طالما (ع < 3) {
    اطبع("العدد: " + ع)
    ع = ع + 1
}

# الدوال
دالة ترحيب(الاسم) {
    اطبع("أهلا " + الاسم)
}
ترحيب("عالم A+")
