# 11: Arabic-First
دالة ترحيب(اسم) { ارجع "أهلاً " + اسم }
متغير را = "عالم A+"
متغير العام = 2026
اطبع(ترحيب(را))
اطبع("عام " + العام)
متغير درجة = 85
إذا (درجة >= 70) { اطبع("ناجح") } وإلا { اطبع("راسب") }
متغير ع = 0
طالما (ع < 3) { اطبع("العد: " + ع) ع = ع + 1 }
لكل (عنصر in ["أ", "ب", "ج"]) { اطبع("العنصر: " + عنصر) }
صنف شخص { متغير را دالة عرف(اسم) { نفس.را = اسم } دالة رحب() { اطبع("مرحباً، أنا " + هذا.را) } }
متغير المستخدم = جديد شخص() المستخدم.عرف("أحمد") المستخدم.رحب()
