# ============================================================
# 01: Control Flow - Conditions & Loops
# ============================================================
# التحكم في التدفق - الشروط والحلقات

# If / else
let score = 85
if (score >= 90) {
    print("Excellent")
} else if (score >= 70) {
    print("Good")
} else {
    print("Needs improvement")
}

# Switch
let day = 3
switch (day) {
    case 1: print("Monday") break
    case 2: print("Tuesday") break
    case 3: print("Wednesday") break
    default: print("Unknown")
}

# While loop
let i = 0
while (i < 5) {
    print("While: " + i)
    i = i + 1
}

# For loop (C-style)
for (j = 0; j < 3; j = j + 1) {
    print("For: " + j)
}

# For-in loop
let items = ["a", "b", "c"]
for (item in items) {
    print("Item: " + item)
}

# Break / continue
for (k = 0; k < 10; k = k + 1) {
    if (k == 3) { continue }
    if (k == 7) { break }
    print("k = " + k)
}
