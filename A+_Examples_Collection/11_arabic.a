# ============================================================
# 11: Arabic-First - لغة عربية بالكامل
# ============================================================
# جميع الكلمات المفتاحية بالعربية

# دالة (func)
دالة ترحيب(اسم) {
    ارجع "أهلاً " + اسم
}

# متغيرات (let)
متغير ع = "عالم A+"
متغير العام = 2026

اطبع(ترحيب(ع))
اطبع("عام " + العام)

# شروط (if/else)
متغير درجة = 85
إذا (درجة >= 70) {
    اطبع("ناجح")
} وإلا {
    اطبع("راسب")
}

# حلقة while (طالما)
متغير ع = 0
طالما (ع < 3) {
    اطبع("العد: " + ع)
    ع = ع + 1
}

# حلقة for (لكل)
لكل (عنصر in ["أ", "ب", "ج"]) {
    اطبع("العنصر: " + عنصر)
}

# صنف (class)
صنف شخص {
    متغير ع
    
    دالة عرف(اسم) {
        نفس.ع = اسم
    }
    
    دالة رحب() {
        اطبع("مرحباً، أنا " + هذا.ع)
    }
}

متغير المستخدم = جديد شخص()
المستخدم.عرف("أحمد")
المستخدم.رحب()
